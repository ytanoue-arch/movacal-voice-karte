# ===== 認証（どちらか / 両方）=====
# (A) Google Workspace サインイン（推奨）
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# 許可する Workspace ドメイン（hd クレーム）。カンマ区切り。例: yamato-clinic.org
ALLOWED_HD=your-workspace-domain.example
# 任意: さらにメール単位で絞る場合（カンマ区切り、未設定なら制限なし）
# ALLOWED_EMAILS=doctor1@your-domain,doctor2@your-domain

# (B) 共有トークン（初期セットアップ/フォールバック）。本番は (A) を推奨。
APP_TOKEN=change-me-to-a-long-random-string

# ===== Gemini =====
# このサービス専用キーを発行して使用（VMバッチとクォータ競合を避ける）。
# ※チャット等に貼ったキーは漏えい扱いとし、必ず再発行（ローテーション）してください。

# ===== MOVACAL WebAPI（認証は全院共通） =====
MOVACAL_PROVIDER=150015
MOVACAL_PASSWORD=your-movacal-password
MOVACAL_PRIVATE_KEY=your-movacal-pre-shared-key
# 既定クリニック（PWAの診療所セレクタ未使用時のフォールバック）
MOVACAL_CLINIC_ID=20221
MOVACAL_CLINIC_CODE=4TPbMFAiHSUk
MOVACAL_DIAG_DEPT=01
MOVACAL_USER_NAME=音声カルテ
# 各院の clinic_id / clinic_code は clinics.json で管理（code はサーバー側のみ）。
# 環境変数で渡したい場合は CLINICS_JSON に JSON 文字列を入れると clinics.json より優先。
# CLINICS_JSON={"clinics":[{"id":"20221","name":"日吉","code":"..."}]}

# AI（Vertex AI・APIキー不要）
VERTEX_PROJECT=movacal-shuunou
VERTEX_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-2.5-flash
# 緊急用: USE_VERTEX=0 と GEMINI_API_KEY でAPIキー方式に戻せる
